---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';

const pageTitle = 'Apoorva Sahay | Algorithms, Interview Prep & System Design';
const pageDescription =
	'Clear, pattern-first walkthroughs of algorithms and coding interview problems, plus system design and AI-assisted coding notes by Apoorva Sahay.';

// Drafts are visible in `npm run dev` only.
const posts = (await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
// Structured data helps Google understand the site and show it as a blog with listed posts.
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			name: SITE_TITLE,
			url: Astro.site?.href,
			description: pageDescription,
		},
		{
			'@type': 'Blog',
			name: `${SITE_TITLE} Blog`,
			url: new URL('/blog/', Astro.site).href,
			blogPost: posts.map((post) => ({
				'@type': 'BlogPosting',
				headline: post.data.title,
				description: post.data.description,
				datePublished: post.data.pubDate.toISOString(),
				url: new URL(`/blog/${post.id}/`, Astro.site).href,
				author: { '@type': 'Person', name: SITE_TITLE },
			})),
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style>
			ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			li {
				padding: 1.25em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			li a {
				font-family: var(--font-sans), system-ui, sans-serif;
				font-size: 1.5em;
				font-weight: 500;
				line-height: 1.3;
				text-decoration: none;
			}
			li a:hover {
				text-decoration: underline;
			}
			.date {
				display: block;
				margin-top: 0.25em;
				color: rgb(var(--gray));
				font-family: var(--font-sans), system-ui, sans-serif;
				font-size: 0.85em;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Algorithms, Explained One Pattern at a Time</h1>
			<p>{pageDescription}</p>
			<ul>
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<time class="date" datetime={post.data.pubDate.toISOString()}>
								<FormattedDate date={post.data.pubDate} />
							</time>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
